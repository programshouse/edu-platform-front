# ─── Mock API Configuration ───────────────────────────────────────────────────
#
# Set VITE_USE_MOCK=true to use the in-memory mock service (no real API needed).
# Set VITE_USE_MOCK=false to connect to a real backend via VITE_API_BASE_URL.
#
# These values are safe to commit — use .env.local to override locally.
# ──────────────────────────────────────────────────────────────────────────────

VITE_USE_MOCK=true

# Delay for mock responses (ms) — increase to test loading states
VITE_MOCK_DELAY_MS=600

# Random failure rate (0.0 – 1.0) — set to 0.1 to test error handling
VITE_MOCK_FAIL_RATE=0

# ─── Real API (used when VITE_USE_MOCK=false) ─────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1
